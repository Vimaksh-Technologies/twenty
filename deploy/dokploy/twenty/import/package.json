{
  "name": "@paryatech/twenty-import",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "apply:import": "tsc --outDir .runtime --noEmit false && node .runtime/import-approved.js apply",
    "attest:revocation": "tsc --outDir .runtime --noEmit false && node .runtime/import-approved.js attest",
    "build": "tsc --outDir .runtime --noEmit false",
    "prepare:import": "tsc --outDir .runtime --noEmit false && node .runtime/prepare-import.js",
    "seal:import": "tsc --outDir .runtime --noEmit false && node .runtime/import-approved.js seal",
    "reconcile:import": "tsc --outDir .runtime --noEmit false && node .runtime/reconcile-import.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}

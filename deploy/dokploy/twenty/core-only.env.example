COMPOSE_PROFILES=core-only
BACKUP_MODE=core-only
AUDIT_LOGS_ENABLED=false
BACKUP_RETENTION_DAYS=30
DELETION_PROPAGATION_DAYS=30

TWENTY_IMAGE_REF=ghcr.io/vimaksh-technologies/twenty@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
TWENTY_BACKUP_IMAGE_REF=ghcr.io/vimaksh-technologies/twenty-backup@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
TWENTY_APP_RELEASE=replace-with-release
SERVER_URL=https://crm.example.com

PG_DATABASE_NAME=default
PG_DATABASE_USER=twenty_app
PG_DATABASE_PASSWORD=replace-with-app-database-password
PG_DATABASE_URL=postgres://twenty_app:replace-with-app-database-password@db:5432/default
BACKUP_PG_DATABASE_USER=twenty_backup
BACKUP_PG_DATABASE_URL=postgres://twenty_backup:replace-with-backup-database-password@db:5432/default?options=-c%20default_transaction_read_only%3Don
REDIS_URL=redis://redis:6379

ENCRYPTION_KEY=replace-with-encryption-key
APP_SECRET=replace-with-app-secret
STORAGE_S3_NAME=replace-with-general-file-bucket
STORAGE_S3_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
STORAGE_S3_ACCESS_KEY_ID=replace-with-general-file-access-key
STORAGE_S3_SECRET_ACCESS_KEY=replace-with-general-file-secret-key

BACKUP_HEALTHCHECK_URL=https://heartbeat.example.com/replace-with-success-id
BACKUP_FAILURE_HEALTHCHECK_URL=https://heartbeat.example.com/replace-with-failure-id
BACKUP_INTERVAL_SECONDS=3600
RECOVERY_RPO_MINUTES=60
RECOVERY_RTO_MINUTES=120

MESSAGING_PROVIDER_GMAIL_ENABLED=false
CALENDAR_PROVIDER_GOOGLE_ENABLED=false
EMAIL_DRIVER=LOGGER
